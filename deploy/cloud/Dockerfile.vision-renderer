FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir Flask==3.1.2 gunicorn==23.0.0 playwright==1.55.0
WORKDIR /app
COPY services/vision/renderer.py /app/renderer.py
COPY services/vision/slang-editor /app/slang-editor
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin renderer
USER 10001:10001
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "45", "renderer:app"]
