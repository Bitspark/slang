{
    on_demand_tls {
        ask http://127.0.0.1:9010/_certificate
    }
}

slangapps.com {
    redir https://slang.bitspark.com permanent
}

https:// {
    tls {
        on_demand
    }
    @program host *.slangapps.com
    handle @program {
        @root path /
        handle @root {
            request_body {
                max_size 2MB
            }
            reverse_proxy 127.0.0.1:9010
        }
        respond "Not found" 404
    }
    respond "Not found" 404
}
