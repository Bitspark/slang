FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/shared:/app
WORKDIR /app
COPY cloud/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY telstar /opt/telstar
RUN pip install --no-cache-dir /opt/telstar
COPY cloud/shared /opt/shared
ARG SERVICE
COPY services/${SERVICE}/ /app/
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin service
USER 10001:10001
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "2", "--timeout", "45", "--access-logfile", "-", "index:app"]
