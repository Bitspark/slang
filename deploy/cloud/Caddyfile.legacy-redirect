# Optional DNS-cache fallback on retired bn2-space-h3; no execution gateway.
tryslang.com, www.tryslang.com {
    redir https://slang.bitspark.com/ 308
}

slang.bitspark.com {
    encode gzip
    @app path /app /app/*
    redir @app https://slang.run/ 308
    root * /srv/tryslang/retired-site/site
    try_files {path} {path}/index.html
    file_server
}
